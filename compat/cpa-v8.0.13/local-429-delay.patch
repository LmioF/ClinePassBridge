diff --git a/internal/pluginhost/host_request_context.go b/internal/pluginhost/host_request_context.go
new file mode 100644
index 0000000000000000000000000000000000000000..9575fc17c4138a08f90b385b68a1e4a8a491e182
--- /dev/null
+++ b/internal/pluginhost/host_request_context.go
@@ -0,0 +1,61 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// Optional scheduling callbacks; plugins on unmodified hosts fall back on an
+// unsupported-method error without changing schema_version or registration.
+func (h *Host) callHostSchedulingCapabilities() ([]byte, error) {
+	return marshalRPCResult(map[string]any{
+		"local_delay_supported":     true,
+		"request_context_supported": true,
+		"local_delay_ms":            5000,
+	})
+}
+
+func (h *Host) callHostRequestContext(caller context.Context, raw []byte) ([]byte, error) {
+	var req struct {
+		HostCallbackID string `json:"host_callback_id"`
+	}
+	if err := json.Unmarshal(raw, &req); err != nil {
+		return nil, err
+	}
+	callbackID := strings.TrimSpace(req.HostCallbackID)
+	if callbackID == "" {
+		return nil, fmt.Errorf("host callback ID is required")
+	}
+	parent, pluginID, instance, exists := h.lookupCallbackContext(callbackID)
+	response := struct {
+		Supported bool       `json:"supported"`
+		State     string     `json:"state"`
+		Deadline  *time.Time `json:"deadline,omitempty"`
+	}{Supported: true, State: "active"}
+	if !exists {
+		response.State = "closed"
+		return marshalRPCResult(response)
+	}
+	if callerID := hostCallbackPluginIDFromContext(caller); callerID != "" && callerID != pluginID {
+		return nil, fmt.Errorf("host callback ID does not belong to the calling plugin")
+	}
+	if callerInstance := hostCallbackInstanceFromContext(caller); callerInstance != instance && (callerInstance != nil || instance != nil) {
+		return nil, fmt.Errorf("host callback ID does not belong to the calling plugin instance")
+	}
+	if deadline, ok := parent.Deadline(); ok {
+		response.Deadline = &deadline
+	}
+	switch {
+	case errors.Is(parent.Err(), context.DeadlineExceeded):
+		response.State = "deadline_exceeded"
+	case parent.Err() != nil:
+		response.State = "canceled"
+	case instance != nil && instance.closed.Load():
+		response.State = "closed"
+	}
+	return marshalRPCResult(response)
+}
diff --git a/internal/pluginhost/host_request_context_test.go b/internal/pluginhost/host_request_context_test.go
new file mode 100644
