+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type streamCallbackFixtureExecutor struct {
+	fakeProviderExecutor
+	chunks  <-chan pluginapi.ExecutorStreamChunk
+	failure error
+	calls   []string
+}
+
+func (e *streamCallbackFixtureExecutor) Execute(ctx context.Context, auth *coreauth.Auth, _ coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+	coreexecutor.MarkUpstreamAttempt(ctx)
+	e.calls = append(e.calls, auth.ID)
+	return coreexecutor.Response{}, e.failure
+}
+
+func (e *streamCallbackFixtureExecutor) ExecuteStream(ctx context.Context, auth *coreauth.Auth, _ coreexecutor.Request, _ coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	coreexecutor.MarkUpstreamAttempt(ctx)
+	e.calls = append(e.calls, auth.ID)
+	return &coreexecutor.StreamResult{Chunks: mapExecutorStreamChunks(ctx, e.chunks)}, nil
+}
+
+func streamCallbackFixtureManager(t *testing.T, executor *streamCallbackFixtureExecutor, count int) (*coreauth.Manager, []string) {
+	t.Helper()
+	manager := coreauth.NewManager(nil, &coreauth.FillFirstSelector{}, nil)
+	manager.SetRetryConfig(3, 0, 0)
+	manager.RegisterExecutor(executor)
+	var ids []string
+	for i := 0; i < count; i++ {
+		id := t.Name() + "/" + string(rune('a'+i))
+		auth := &coreauth.Auth{
+			ID: id, Provider: executor.Identifier(), Status: coreauth.StatusActive,
+			Attributes: map[string]string{"priority": "10"},
+			Metadata:   map[string]any{"disable_cooling": false},
+		}
+		if i > 0 {
+			auth.Attributes["priority"] = "0"
+		}
+		registry.GetGlobalRegistry().RegisterClient(id, executor.Identifier(), []*registry.ModelInfo{{ID: "callback-model"}, {ID: "callback-sibling"}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, id)
+	}
+	return manager, ids
+}
+
+func callStreamFixtureCallback(t *testing.T, host *Host, method string, request any) {
+	t.Helper()
+	raw, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response, err := host.callFromPlugin(context.Background(), method, raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	capability, err := decodeRPCEnvelope[pluginapi.HostStreamCallbackResponse](response)
+	if err != nil || !capability.ErrorDetailsSupported {
+		t.Fatalf("structured error capability = %+v, error = %v", capability, err)
+	}
+}
+
+func TestHostStreamErrorDetailsReachAuthResult(t *testing.T) {
+	retryAt := time.Now().UTC().Add(time.Hour).Truncate(time.Second)
+	for _, test := range []struct {
+		name    string
+		details *pluginapi.HostStreamErrorDetails
+		penalty bool
+	}{
+		{name: "incomplete_code", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 502, Code: upstreamTransportIncompleteCode, Phase: "stream"}},
+		{name: "local_cancellation", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 499, Code: requestCanceledCode, Scope: "request"}},
+		{name: "local_deadline", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 504, Code: requestDeadlineCode, Scope: "request"}},
+		{name: "network_callback", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 502, Code: upstreamNetworkErrorCode, Scope: "request"}},
+		{name: "explicit_request_scope", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 502, Code: "request_fault", RequestScoped: true}},
+		{name: "ordinary_502", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 502, Code: "upstream_error"}, penalty: true},
+		{name: "ordinary_504", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 504, Code: "upstream_error"}, penalty: true},
+		{name: "ordinary_401", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 401, Code: "upstream_auth_error"}, penalty: true},
+		{name: "ordinary_403", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 403, Code: "upstream_auth_error"}, penalty: true},
+		{name: "credential_quota", details: &pluginapi.HostStreamErrorDetails{HTTPStatus: 429, Code: "quota_exceeded", Scope: "credential", RetryAt: &retryAt}, penalty: true},
+		{name: "legacy_string", penalty: true},
+	} {
+		for _, method := range []string{pluginabi.MethodHostStreamClose, pluginabi.MethodHostStreamEmit} {
+			t.Run(test.name+"/"+method, func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				host := New()
+				id, chunks, cleanup := host.streams.open(ctx)
+				defer cleanup()
+				callStreamFixtureCallback(t, host, pluginabi.MethodHostStreamEmit, pluginapi.HostStreamEmitRequest{StreamID: id, Payload: []byte("data: started\n\n")})
+				const message = "upstream response failed"
+				if method == pluginabi.MethodHostStreamClose {
+					callStreamFixtureCallback(t, host, method, pluginapi.HostStreamCloseRequest{StreamID: id, Error: message, ErrorDetails: test.details})
+				} else {
+					callStreamFixtureCallback(t, host, method, pluginapi.HostStreamEmitRequest{StreamID: id, Error: message, ErrorDetails: test.details})
+					callStreamFixtureCallback(t, host, pluginabi.MethodHostStreamClose, pluginapi.HostStreamCloseRequest{StreamID: id})
+				}
+				executor := &streamCallbackFixtureExecutor{fakeProviderExecutor: fakeProviderExecutor{provider: "callback-fixture"}, chunks: chunks}
+				manager, ids := streamCallbackFixtureManager(t, executor, 1)
+				result, err := manager.ExecuteStream(ctx, []string{executor.Identifier()}, coreexecutor.Request{Model: "callback-model"}, coreexecutor.Options{Stream: true})
+				if err != nil {
+					t.Fatal(err)
+				}
+				var payloads, failures int
+				for chunk := range result.Chunks {
+					if len(chunk.Payload) > 0 {
+						payloads++
+					}
+					if chunk.Err == nil {
+						continue
+					}
+					failures++
+					if chunk.Err.Error() != message {
+						t.Fatalf("legacy error message changed: %v", chunk.Err)
+					}
+					if test.details != nil {
+						var typed *streamCallbackError
+						var authError *coreauth.Error
+						if !errors.As(chunk.Err, &typed) || typed.StatusCode() != test.details.HTTPStatus || !errors.As(chunk.Err, &authError) || authError.Code != test.details.Code {
+							t.Fatalf("typed error lost through bridge/auth: %T %v", chunk.Err, chunk.Err)
+						}
+					}
+				}
+				if payloads != 1 || failures != 1 || len(executor.calls) != 1 {
+					t.Fatalf("started stream replayed or lost chunks: payloads=%d failures=%d calls=%v", payloads, failures, executor.calls)
+				}
+				auth, _ := manager.GetByID(ids[0])
+				state := auth.ModelStates["callback-model"]
+				if test.penalty {
+					if state == nil || !state.Unavailable || !state.NextRetryAfter.After(time.Now()) {
+						t.Fatalf("ordinary error lost cooldown: %+v", state)
+					}
+				} else if auth.Unavailable || auth.Quota.Exceeded || !auth.NextRetryAfter.IsZero() || (state != nil && (state.Unavailable || state.Quota.Exceeded || !state.NextRetryAfter.IsZero())) {
+					t.Fatalf("request-scoped stream fault penalized auth: %+v", auth)
+				}
+				if test.name == "credential_quota" && (auth.Quota.Reason != "credential_quota" || auth.Quota.NextRecoverAt.Before(retryAt.Add(-time.Second)) || state.NextRetryAfter.Before(retryAt.Add(-time.Second))) {
+					t.Fatalf("credential scope/RetryAfter lost: quota=%+v model=%+v", auth.Quota, state)
+				}
+			})
+		}
+	}
+}
+
+func TestRPCRequestFaultStopsWithoutCooldown(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		code   string
+		status int
+		calls  int
+	}{
+		{name: "classified_incomplete", code: upstreamTransportIncompleteCode, status: 502, calls: 1},
+		{name: "local_cancellation", code: requestCanceledCode, status: 499, calls: 1},
+		{name: "local_deadline", code: requestDeadlineCode, status: 504, calls: 1},
+		{name: "ordinary_502", code: "upstream_error", status: 502, calls: 2},
+		{name: "ordinary_504", code: "upstream_error", status: 504, calls: 2},
+		{name: "ordinary_401", code: "upstream_auth_error", status: 401, calls: 2},
+		{name: "ordinary_403", code: "upstream_auth_error", status: 403, calls: 2},
+		{name: "ordinary_429", code: "upstream_rate_limited", status: 429, calls: 2},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			raw, err := json.Marshal(pluginabi.Envelope{Error: &pluginabi.Error{Code: test.code, Message: "synthetic upstream response failure", HTTPStatus: test.status}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, failure := decodeRPCEnvelope[pluginapi.ExecutorResponse](raw)
+			if failure == nil {
+				t.Fatal("expected RPC error")
+			}
+			executor := &streamCallbackFixtureExecutor{fakeProviderExecutor: fakeProviderExecutor{provider: "callback-fixture"}, failure: failure}
+			manager, ids := streamCallbackFixtureManager(t, executor, 2)
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			_, err = manager.Execute(ctx, []string{executor.Identifier()}, coreexecutor.Request{Model: "callback-model"}, coreexecutor.Options{})
+			var rpcFailure rpcError
+			if !errors.As(err, &rpcFailure) || rpcFailure.Code != test.code || rpcFailure.StatusCode() != test.status {
+				t.Fatalf("RPC classification changed at execution boundary: %T %v", err, err)
+			}
+			if len(executor.calls) != test.calls || executor.calls[0] != ids[0] {
+				t.Fatalf("unexpected retry/priority selection: %v", executor.calls)
+			}
+			for _, id := range ids {
+				auth, _ := manager.GetByID(id)
+				state := auth.ModelStates["callback-model"]
+				if test.calls == 1 {
+					if auth.Unavailable || !auth.NextRetryAfter.IsZero() || (state != nil && (state.Unavailable || !state.NextRetryAfter.IsZero())) {
+						t.Fatalf("classified RPC request fault cooled auth: %+v", auth)
+					}
+				} else if state == nil || !state.Unavailable || !state.NextRetryAfter.After(state.UpdatedAt) {
+					t.Fatalf("ordinary RPC %d lost cooldown: %+v", test.status, state)
+				}
+			}
+		})
+	}
+}
+
+func TestPluginRequestFaultHintsPreserveCredentialStatusCooldown(t *testing.T) {
+	for _, code := range []string{requestCanceledCode, requestDeadlineCode, upstreamTransportIncompleteCode, upstreamNetworkErrorCode} {
+		for _, status := range []int{401, 402, 403, 429} {
+			t.Run(code+"/"+http.StatusText(status), func(t *testing.T) {
+				const message = "synthetic credential failure"
+				_, rpcFailure := decodeEnvelopeResult[pluginapi.ExecutorResponse](pluginabi.Envelope{Error: &pluginabi.Error{Code: code, Message: message, HTTPStatus: status}})
+				streamFailure := newStreamCallbackError(message, &pluginapi.HostStreamErrorDetails{HTTPStatus: status, Code: code, RequestScoped: true, Scope: "request"})
+				for name, failure := range map[string]error{"rpc": rpcFailure, "stream": streamFailure} {
+					t.Run(name, func(t *testing.T) {
+						var scoped coreexecutor.RequestScopedError
+						if !errors.As(failure, &scoped) || scoped.IsRequestScoped() {
+							t.Fatalf("credential status %d was exempted by request hint: %v", status, failure)
+						}
+						executor := &streamCallbackFixtureExecutor{fakeProviderExecutor: fakeProviderExecutor{provider: "callback-fixture"}, failure: failure}
+						manager, ids := streamCallbackFixtureManager(t, executor, 1)
+						_, err := manager.Execute(context.Background(), []string{executor.Identifier()}, coreexecutor.Request{Model: "callback-model"}, coreexecutor.Options{})
+						if err == nil {
+							t.Fatal("expected credential failure")
+						}
+						auth, _ := manager.GetByID(ids[0])
+						state := auth.ModelStates["callback-model"]
+						if state == nil || !state.Unavailable || !state.NextRetryAfter.After(state.UpdatedAt) {
+							t.Fatalf("credential status %d lost cooldown: %+v", status, state)
+						}
+					})
+				}
+			})
+		}
+	}
+}
