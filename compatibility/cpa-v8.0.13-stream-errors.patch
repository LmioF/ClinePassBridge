diff --git a/internal/pluginhost/http_callback_errors.go b/internal/pluginhost/http_callback_errors.go
new file mode 100644
index 00000000..54750cc8
--- /dev/null
+++ b/internal/pluginhost/http_callback_errors.go
@@ -0,0 +1,126 @@
+package pluginhost
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"syscall"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// Only typed transport sources qualify. url.Error alone, arbitrary callback
+// text and upstream HTTP error statuses never establish a network fault.
+func classifyHostHTTPError(ctx context.Context, err error) *pluginapi.HostHTTPErrorDetails {
+	if err == nil {
+		return nil
+	}
+	var status interface{ StatusCode() int }
+	if errors.As(err, &status) && status.StatusCode() >= 400 && status.StatusCode() <= 599 {
+		return nil
+	}
+	details := &pluginapi.HostHTTPErrorDetails{Code: upstreamNetworkErrorCode, HTTPStatus: 502}
+	switch {
+	case errors.Is(err, context.DeadlineExceeded) || (ctx != nil && errors.Is(context.Cause(ctx), context.DeadlineExceeded)):
+		details.Kind, details.Code, details.HTTPStatus = "deadline", requestDeadlineCode, 504
+	case errors.Is(err, context.Canceled) || (ctx != nil && errors.Is(ctx.Err(), context.Canceled)):
+		details.Kind, details.Code, details.HTTPStatus = "canceled", requestCanceledCode, 499
+	case errors.Is(err, io.EOF), errors.Is(err, io.ErrUnexpectedEOF):
+		details.Kind = "eof"
+	case errors.Is(err, syscall.ECONNRESET), errors.Is(err, syscall.ECONNABORTED), errors.Is(err, syscall.EPIPE):
+		details.Kind = "connection_reset"
+	case errors.Is(err, net.ErrClosed), errors.Is(err, io.ErrClosedPipe):
+		details.Kind = "connection_closed"
+	default:
+		var dns *net.DNSError
+		var certificate *tls.CertificateVerificationError
+		var authority x509.UnknownAuthorityError
+		var invalidCertificate x509.CertificateInvalidError
+		var hostname x509.HostnameError
+		var record tls.RecordHeaderError
+		var alert tls.AlertError
+		var timeout interface{ Timeout() bool }
+		var operation *net.OpError
+		switch {
+		case errors.As(err, &dns):
+			details.Kind = "dns"
+		case errors.As(err, &certificate), errors.As(err, &authority), errors.As(err, &invalidCertificate), errors.As(err, &hostname), errors.As(err, &record), errors.As(err, &alert):
+			details.Kind = "tls"
+		case errors.As(err, &timeout) && timeout.Timeout():
+			details.Kind = "timeout"
+		case errors.As(err, &operation), errors.Is(err, syscall.ECONNREFUSED), errors.Is(err, syscall.ENETUNREACH), errors.Is(err, syscall.EHOSTUNREACH):
+			details.Kind = "network"
+		default:
+			return nil
+		}
+	}
+	return details
+}
+
+type safeHostHTTPError struct {
+	err error
+}
+
+func (e *safeHostHTTPError) Error() string { return "host HTTP callback failed" }
+func (e *safeHostHTTPError) Unwrap() error { return e.err }
+
+func hostHTTPCallbackFailure(request []byte, ctx context.Context, err error) ([]byte, error) {
+	var options struct {
+		ErrorDetailsSupported bool `json:"error_details_supported"`
+	}
+	details := classifyHostHTTPError(ctx, err)
+	if json.Unmarshal(request, &options) == nil && options.ErrorDetailsSupported && details != nil {
+		return marshalRPCResult(pluginapi.HostHTTPErrorResult{
+			Error: "host HTTP callback failed (" + details.Kind + ")", ErrorDetails: details,
+		})
+	}
+	// Transport/configuration errors can contain URLs, credentials or request
+	// fragments. Retain their identity for in-process callers, never their text.
+	return nil, &safeHostHTTPError{err: err}
+}
+
+// DoStream's producer may close its channel silently when the request context
+// ends. Preserve that context as a terminal error, without adding a deadline.
+// stop unblocks the forwarding goroutine when a caller closes/abandons a stream.
+func preserveHostHTTPStreamErrors(ctx context.Context, input <-chan pluginapi.HTTPStreamChunk) (<-chan pluginapi.HTTPStreamChunk, func()) {
+	output := make(chan pluginapi.HTTPStreamChunk)
+	done := make(chan struct{})
+	var once sync.Once
+	stop := func() { once.Do(func() { close(done) }) }
+	go func() {
+		defer close(output)
+		send := func(chunk pluginapi.HTTPStreamChunk) bool {
+			select {
+			case output <- chunk:
+				return true
+			case <-done:
+				return false
+			}
+		}
+		for {
+			select {
+			case <-done:
+				return
+			case <-ctx.Done():
+				send(pluginapi.HTTPStreamChunk{Err: context.Cause(ctx)})
+				return
+			case chunk, ok := <-input:
+				if !ok {
+					if ctx.Err() != nil {
+						send(pluginapi.HTTPStreamChunk{Err: context.Cause(ctx)})
+					}
+					return
+				}
+				if !send(chunk) || chunk.Err != nil {
+					return
+				}
+			}
+		}
+	}()
+	return output, stop
+}
