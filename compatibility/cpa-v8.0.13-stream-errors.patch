+)
+
+func TestHostHTTPCallbackFaultClassificationAndOptIn(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		err    error
+		code   string
+		status int
+	}{
+		{"reset", syscall.ECONNRESET, upstreamNetworkErrorCode, 502},
+		{"eof", io.ErrUnexpectedEOF, upstreamNetworkErrorCode, 502},
+		{"dns", &net.DNSError{Err: "fixture resolution failure"}, upstreamNetworkErrorCode, 502},
+		{"cancel", context.Canceled, requestCanceledCode, 499},
+		{"deadline", context.DeadlineExceeded, requestDeadlineCode, 504},
+		{"untyped text", errors.New("connection reset; HTTP 401"), "", 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// A proxy URL in the outer error must not escape the callback.
+			err := &url.Error{Op: "Post", URL: "https://fixture-user:fixture-secret@example.invalid", Err: tc.err}
+			response, rpcErr := hostHTTPCallbackFailure([]byte(`{"error_details_supported":true}`), context.Background(), err)
+			if tc.code == "" {
+				if rpcErr == nil || strings.Contains(rpcErr.Error(), "fixture-secret") {
+					t.Fatalf("legacy/unknown fault lost conservative fallback: %v", rpcErr)
+				}
+				return
+			}
+			fault, decodeErr := decodeRPCEnvelope[pluginapi.HostHTTPErrorResult](response)
+			if rpcErr != nil || decodeErr != nil || fault.ErrorDetails == nil || fault.ErrorDetails.Code != tc.code || fault.ErrorDetails.HTTPStatus != tc.status {
+				t.Fatalf("fault = %#v, callback=%v, decode=%v", fault, rpcErr, decodeErr)
+			}
+			if strings.Contains(string(response), "fixture-secret") {
+				t.Fatal("callback exposed proxy credentials")
+			}
+			_, legacyErr := hostHTTPCallbackFailure([]byte(`{}`), context.Background(), err)
+			if legacyErr == nil || !errors.Is(legacyErr, tc.err) {
+				t.Fatal("legacy callback changed its RPC error contract")
+			}
+		})
+	}
+}
+
+func TestHostHTTPStreamPreservesReadFaultAndCancellation(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "100")
+		_, _ = w.Write([]byte("partial body"))
+	}))
+	defer server.Close()
+	host := New()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	raw, err := host.callFromPlugin(ctx, pluginabi.MethodHostHTTPDoStream, []byte(`{"url":"`+server.URL+`","error_details_supported":true}`))
+	stream, decodeErr := decodeRPCEnvelope[rpcHostHTTPStreamResponse](raw)
+	if err != nil || decodeErr != nil || stream.StatusCode != 200 {
+		t.Fatalf("stream open: %v, %v, %#v", err, decodeErr, stream)
+	}
+	defer host.httpStreams.close("", nil, stream.StreamID)
+	var body strings.Builder
+	var terminal *pluginapi.HostHTTPErrorDetails
+	for i := 0; i < 4; i++ {
+		raw, err = host.callFromPlugin(ctx, pluginabi.MethodHostHTTPStreamRead, []byte(`{"stream_id":"`+stream.StreamID+`","error_details_supported":true}`))
+		chunk, decodeErr := decodeRPCEnvelope[rpcHostHTTPStreamReadResponse](raw)
+		if err != nil || decodeErr != nil {
+			t.Fatalf("read: %v, %v", err, decodeErr)
+		}
+		body.Write(chunk.Payload)
+		if chunk.Done {
+			terminal = chunk.ErrorDetails
+			break
+		}
+	}
+	if body.String() != "partial body" || terminal == nil || terminal.Code != upstreamNetworkErrorCode || terminal.Kind != "eof" {
+		t.Fatalf("body=%q, terminal=%#v", body.String(), terminal)
+	}
+	parent, cancelParent := context.WithCancel(context.Background())
+	chunks, stop := preserveHostHTTPStreamErrors(parent, make(chan pluginapi.HTTPStreamChunk))
+	defer stop()
+	cancelParent()
+	select {
+	case chunk := <-chunks:
+		if !errors.Is(chunk.Err, context.Canceled) {
+			t.Fatalf("silent cancellation: %#v", chunk)
+		}
+	case <-ctx.Done():
+		t.Fatal("cancellation did not terminate the stream")
+	}
+}
