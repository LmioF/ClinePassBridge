--- /dev/null
+++ b/sdk/pluginapi/http_callbacks.go
@@ -0,0 +1,19 @@
+package pluginapi
+
+// HostHTTPErrorDetails describes a typed callback transport failure, never an
+// upstream HTTP response. Callers opt in with error_details_supported: true.
+// Kind identifies the source; Code and HTTPStatus preserve the request fault.
+// This metadata does not itself change scheduling for any plugin.
+type HostHTTPErrorDetails struct {
+	Kind       string `json:"kind"`
+	Code       string `json:"code"`
+	HTTPStatus int    `json:"http_status"`
+}
+
+// HostHTTPErrorResult is returned inside a successful RPC envelope on opted-in
+// HTTP callback failure. The HTTP operation still failed; no stream was opened.
+// Legacy callers keep receiving an RPC error instead of this result.
+type HostHTTPErrorResult struct {
+	Error        string                `json:"error"`
+	ErrorDetails *HostHTTPErrorDetails `json:"error_details,omitempty"`
+}
diff --git a/sdk/pluginapi/stream_callbacks.go b/sdk/pluginapi/stream_callbacks.go
new file mode 100644
index 00000000..f82a01b8
--- /dev/null
+++ b/sdk/pluginapi/stream_callbacks.go
@@ -0,0 +1,36 @@
+package pluginapi
+
+import "time"
+
+// HostStreamErrorDetails preserves scheduling semantics for plugin stream errors.
+// RetryAt uses RFC3339 timestamps on the wire. The legacy error string remains
+// the human-readable message and is supported without this object.
+type HostStreamErrorDetails struct {
+	HTTPStatus int    `json:"http_status,omitempty"`
+	Code       string `json:"code,omitempty"`
+	// Scope accepts "credential" or "account" for credential-wide failures.
+	Scope         string     `json:"scope,omitempty"`
+	RetryAt       *time.Time `json:"retry_at,omitempty"`
+	RequestScoped bool       `json:"request_scoped,omitempty"`
+	Phase         string     `json:"phase,omitempty"`
+}
+
+// HostStreamEmitRequest appends output or a typed error to a plugin stream.
+type HostStreamEmitRequest struct {
+	StreamID     string                  `json:"stream_id"`
+	Payload      []byte                  `json:"payload,omitempty"`
+	Error        string                  `json:"error,omitempty"`
+	ErrorDetails *HostStreamErrorDetails `json:"error_details,omitempty"`
+}
+
+// HostStreamCloseRequest closes a plugin stream after its pending output.
+type HostStreamCloseRequest struct {
+	StreamID     string                  `json:"stream_id"`
+	Error        string                  `json:"error,omitempty"`
+	ErrorDetails *HostStreamErrorDetails `json:"error_details,omitempty"`
+}
+
+// HostStreamCallbackResponse advertises structured stream error support.
+type HostStreamCallbackResponse struct {
+	ErrorDetailsSupported bool `json:"error_details_supported"`
+}
diff --git a/sdk/pluginapi/stream_callbacks_test.go b/sdk/pluginapi/stream_callbacks_test.go
new file mode 100644
index 00000000..c134b163
--- /dev/null
+++ b/sdk/pluginapi/stream_callbacks_test.go
@@ -0,0 +1,45 @@
+package pluginapi
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestHostStreamErrorDetailsWireCompatibility(t *testing.T) {
+	const legacy = `{"stream_id":"fixture","error":"truncated response"}`
+	var request HostStreamCloseRequest
+	if err := json.Unmarshal([]byte(legacy), &request); err != nil || request.ErrorDetails != nil || request.Error != "truncated response" {
+		t.Fatalf("legacy string request changed: %+v, error = %v", request, err)
+	}
+	encoded, err := json.Marshal(request)
+	if err != nil || string(encoded) != legacy {
+		t.Fatalf("legacy request wire format changed: %s, error = %v", encoded, err)
+	}
+	retryAt := time.Date(2026, 10, 13, 1, 2, 3, 0, time.UTC)
+	request.ErrorDetails = &HostStreamErrorDetails{
+		HTTPStatus: 502, Code: "upstream_transport_incomplete", Scope: "request",
+		RetryAt: &retryAt, RequestScoped: true, Phase: "stream",
+	}
+	encoded, err = json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Emit and close share the same error contract, including RFC3339 time.
+	var emit HostStreamEmitRequest
+	if err := json.Unmarshal(encoded, &emit); err != nil {
+		t.Fatal(err)
+	}
+	details := emit.ErrorDetails
+	if emit.Error != request.Error || details == nil || details.HTTPStatus != 502 || details.Code != request.ErrorDetails.Code || details.Scope != "request" || !details.RequestScoped || details.Phase != "stream" || details.RetryAt == nil || !details.RetryAt.Equal(retryAt) {
+		t.Fatalf("structured callback error changed on the wire: %+v", emit)
+	}
+	var wire struct {
+		Details struct {
+			RetryAt string `json:"retry_at"`
+		} `json:"error_details"`
+	}
+	if err := json.Unmarshal(encoded, &wire); err != nil || wire.Details.RetryAt != "2026-10-13T01:02:03Z" {
+		t.Fatalf("retry_at must use RFC3339: %s, error = %v", encoded, err)
+	}
+}
