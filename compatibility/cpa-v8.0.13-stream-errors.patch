diff --git a/internal/pluginhost/stream_errors.go b/internal/pluginhost/stream_errors.go
new file mode 100644
index 00000000..b5a69710
--- /dev/null
+++ b/internal/pluginhost/stream_errors.go
@@ -0,0 +1,83 @@
+package pluginhost
+
+import (
+	"errors"
+	"strings"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+const (
+	upstreamTransportIncompleteCode = "upstream_transport_incomplete"
+	upstreamNetworkErrorCode        = "upstream_network_error"
+	requestCanceledCode             = "request_canceled"
+	requestDeadlineCode             = "request_deadline_exceeded"
+)
+
+// streamCallbackError carries the same typed fault through the stream bridge
+// and the auth manager, without changing the plugin's human-readable message.
+type streamCallbackError struct {
+	result  *coreauth.Error
+	details pluginapi.HostStreamErrorDetails
+}
+
+func newStreamCallbackError(message string, details *pluginapi.HostStreamErrorDetails) error {
+	if details == nil {
+		if message == "" {
+			return nil
+		}
+		return errors.New(message)
+	}
+	copyDetails := *details
+	if details.RetryAt != nil {
+		retryAt := *details.RetryAt
+		copyDetails.RetryAt = &retryAt
+	}
+	if message == "" {
+		message = "plugin stream failed"
+	}
+	return &streamCallbackError{
+		result:  &coreauth.Error{Code: details.Code, Message: message, HTTPStatus: details.HTTPStatus},
+		details: copyDetails,
+	}
+}
+
+func (e *streamCallbackError) Error() string   { return e.result.Message }
+func (e *streamCallbackError) Unwrap() error   { return e.result }
+func (e *streamCallbackError) StatusCode() int { return e.result.HTTPStatus }
+
+func (e *streamCallbackError) IsRequestScoped() bool {
+	// Authentication, payment and quota statuses take precedence over scope hints.
+	switch e.StatusCode() {
+	case 401, 402, 403, 429:
+		return false
+	}
+	if e.details.RequestScoped {
+		return true
+	}
+	switch e.details.Code {
+	case upstreamTransportIncompleteCode, upstreamNetworkErrorCode, requestCanceledCode, requestDeadlineCode:
+		return true
+	default:
+		return false
+	}
+}
+
+func (e *streamCallbackError) IsCredentialScoped() bool {
+	switch strings.ToLower(strings.TrimSpace(e.details.Scope)) {
+	case "account", "credential":
+		return true
+	default:
+		return false
+	}
+}
+
+func (e *streamCallbackError) RetryAfter() *time.Duration {
+	if e.details.RetryAt == nil || e.details.RetryAt.IsZero() {
+		return nil
+	}
+	delay := max(time.Duration(0), time.Until(*e.details.RetryAt))
+	return &delay
+}
