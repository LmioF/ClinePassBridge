@@ -0,0 +1,179 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func TestHostAuthRuntimeCallbacksProjectModelStates(t *testing.T) {
+	now := time.Now().UTC().Truncate(time.Second)
+	retryAt, recoverAt := now.Add(time.Minute), now.Add(time.Hour)
+	auth := &coreauth.Auth{
+		ID: "runtime-model-projection", Provider: "demo", Status: coreauth.StatusError,
+		StatusMessage: "api_key=fixture-auth-secret", Unavailable: true, NextRetryAfter: retryAt,
+		Attributes: map[string]string{"runtime_only": "true"},
+		Metadata:   map[string]any{"api_key": "fixture-metadata-secret", "disable_cooling": false},
+		Quota:      coreauth.QuotaState{Exceeded: true, Reason: "quota", NextRecoverAt: recoverAt},
+		LastError:  &coreauth.Error{Message: "fixture-auth-error-secret", HTTPStatus: 429},
+		ModelStates: map[string]*coreauth.ModelState{
+			"quota-model": {
+				Status: coreauth.StatusError, StatusMessage: "token=fixture-model-secret", Unavailable: true,
+				NextRetryAfter: retryAt,
+				Quota:          coreauth.QuotaState{Exceeded: true, NextRecoverAt: recoverAt, Signals: map[string]string{"secret": "fixture-quota-secret"}},
+				LastError:      &coreauth.Error{Message: "fixture-model-error-secret", HTTPStatus: 429},
+			},
+			"retry-model": {
+				Status: coreauth.StatusError, StatusMessage: "temporarily unavailable", Unavailable: true,
+				NextRetryAfter: recoverAt, Quota: coreauth.QuotaState{NextRecoverAt: retryAt},
+			},
+		},
+	}
+	empty := &coreauth.Auth{
+		ID: "runtime-empty-projection", Provider: "demo", Status: coreauth.StatusActive,
+		Attributes: map[string]string{"runtime_only": "true", coreauth.AttributeAPIKey: "fixture-attribute-key-secret"},
+	}
+	host := New()
+	manager := coreauth.NewManager(nil, nil, nil)
+	host.SetAuthManager(manager)
+	for _, fixture := range []*coreauth.Auth{auth, empty} {
+		if _, err := manager.Register(context.Background(), fixture); err != nil {
+			t.Fatal(err)
+		}
+	}
+	checkEntry := func(t *testing.T, entry pluginapi.HostAuthFileEntry) {
+		t.Helper()
+		if !entry.ModelStatesAvailable || entry.ModelStates == nil {
+			t.Fatal("runtime capability must include an initialized model map")
+		}
+		if entry.CredentialCooldown || entry.CredentialBlocked {
+			t.Fatal("model aggregate was promoted to a credential-wide penalty")
+		}
+		if entry.ID == empty.ID {
+			if len(entry.ModelStates) != 0 {
+				t.Fatal("empty runtime unexpectedly has model states")
+			}
+			if entry.Account != "" {
+				t.Fatal("API key must not be returned as an account identifier")
+			}
+			return
+		}
+		if len(entry.ModelStates) != 2 {
+			t.Fatalf("model state count = %d, want 2", len(entry.ModelStates))
+		}
+		for _, model := range []string{"quota-model", "retry-model"} {
+			state := entry.ModelStates[model]
+			if state.Status != string(coreauth.StatusError) || !state.Unavailable || !state.NextRetryAfter.Equal(recoverAt) {
+				t.Fatalf("model %s lost status or later deadline: %+v", model, state)
+			}
+		}
+	}
+	checkWire := func(t *testing.T, raw []byte) {
+		t.Helper()
+		for _, secret := range []string{"fixture-auth-secret", "fixture-metadata-secret", "fixture-auth-error-secret", "fixture-model-secret", "fixture-quota-secret", "fixture-model-error-secret", "fixture-attribute-key-secret"} {
+			if strings.Contains(string(raw), secret) {
+				t.Fatal("runtime callback exposed a fixture secret")
+			}
+		}
+	}
+	t.Run("list", func(t *testing.T) {
+		raw, err := host.callFromPlugin(context.Background(), pluginabi.MethodHostAuthList, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		checkWire(t, raw)
+		response, err := decodeRPCEnvelope[rpcHostAuthListResponse](raw)
+		if err != nil || len(response.Files) != 2 {
+			t.Fatalf("runtime list count = %d, error = %v", len(response.Files), err)
+		}
+		for _, entry := range response.Files {
+			checkEntry(t, entry)
+		}
+	})
+	for _, fixture := range []*coreauth.Auth{auth, empty} {
+		t.Run("get-runtime/"+fixture.ID, func(t *testing.T) {
+			request, err := json.Marshal(pluginapi.HostAuthGetRequest{AuthIndex: fixture.Index})
+			if err != nil {
+				t.Fatal(err)
+			}
+			raw, err := host.callFromPlugin(context.Background(), pluginabi.MethodHostAuthGetRuntime, request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			checkWire(t, raw)
+			response, err := decodeRPCEnvelope[pluginapi.HostAuthGetRuntimeResponse](raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			checkEntry(t, response.Auth)
+			encoded, err := json.Marshal(response.Auth)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var entry map[string]json.RawMessage
+			if err := json.Unmarshal(encoded, &entry); err != nil {
+				t.Fatal(err)
+			}
+			for _, field := range []string{"metadata", "attributes", "last_error", "quota", "json"} {
+				if _, exists := entry[field]; exists {
+					t.Fatalf("runtime entry contains private field %s", field)
+				}
+			}
+			var states map[string]map[string]json.RawMessage
+			if err := json.Unmarshal(entry["model_states"], &states); err != nil {
+				t.Fatal(err)
+			}
+			for _, state := range states {
+				if len(state) != 4 {
+					t.Fatalf("model projection has %d fields, want 4", len(state))
+				}
+				for _, field := range []string{"status", "status_message", "unavailable", "next_retry_after"} {
+					if _, exists := state[field]; !exists {
+						t.Fatalf("model projection lacks %s", field)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestHostAuthRuntimeCredentialPenaltyScope(t *testing.T) {
+	now := time.Date(2026, 10, 13, 0, 0, 0, 0, time.UTC)
+	future := now.Add(time.Hour)
+	for _, test := range []struct {
+		name     string
+		auth     coreauth.Auth
+		cooldown bool
+		blocked  bool
+	}{
+		{name: "credential_quota", auth: coreauth.Auth{Quota: coreauth.QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: future}, ModelStates: map[string]*coreauth.ModelState{"model": {}}}, cooldown: true},
+		{name: "expired_credential_quota", auth: coreauth.Auth{Quota: coreauth.QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: now.Add(-time.Second)}}},
+		{name: "model_aggregate", auth: coreauth.Auth{Unavailable: true, NextRetryAfter: future, ModelStates: map[string]*coreauth.ModelState{"model": {Unavailable: true, NextRetryAfter: future}}}},
+		{name: "unavailable_without_scope", auth: coreauth.Auth{Unavailable: true, NextRetryAfter: future}},
+		{name: "direct_auth_failure", auth: coreauth.Auth{Status: coreauth.StatusError, Unavailable: true, NextRetryAfter: future, LastError: &coreauth.Error{HTTPStatus: 503}}, cooldown: true},
+		{name: "terminal_unauthorized", auth: coreauth.Auth{Status: coreauth.StatusError, Unavailable: true, LastError: &coreauth.Error{HTTPStatus: 401}}, blocked: true},
+		{name: "pending_unauthorized_refresh", auth: coreauth.Auth{Status: coreauth.StatusError, Unavailable: true, NextRefreshAfter: future, LastError: &coreauth.Error{HTTPStatus: 401}}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var entry pluginapi.HostAuthFileEntry
+			projectHostAuthRuntime(&entry, &test.auth, now)
+			if !entry.ModelStatesAvailable || entry.ModelStates == nil || entry.CredentialCooldown != test.cooldown || entry.CredentialBlocked != test.blocked {
+				t.Fatalf("incorrect runtime scope projection: %+v", entry)
+			}
+		})
+	}
+	var entry pluginapi.HostAuthFileEntry
+	projectHostAuthRuntime(&entry, &coreauth.Auth{ModelStates: map[string]*coreauth.ModelState{
+		"expired": {NextRetryAfter: now.Add(-time.Second), Quota: coreauth.QuotaState{NextRecoverAt: now}},
+		"nil":     nil,
+	}}, now)
+	if len(entry.ModelStates) != 1 || !entry.ModelStates["expired"].NextRetryAfter.IsZero() {
+		t.Fatal("expired deadlines or nil model states leaked into live scheduling projection")
+	}
+}
