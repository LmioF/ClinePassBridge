index 00000000..219ab3b8
--- /dev/null
+++ b/internal/pluginhost/auth_runtime.go
@@ -0,0 +1,51 @@
+package pluginhost
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// runtimeRetryAfter projects only live deadlines, including quota recovery.
+func runtimeRetryAfter(retryAt, recoverAt, now time.Time) time.Time {
+	var next time.Time
+	for _, candidate := range []time.Time{retryAt, recoverAt} {
+		if candidate.After(now) && candidate.After(next) {
+			next = candidate
+		}
+	}
+	return next
+}
+
+func projectHostAuthRuntime(entry *pluginapi.HostAuthFileEntry, auth *coreauth.Auth, now time.Time) {
+	entry.ModelStatesAvailable = true
+	entry.ModelStates = make(map[string]pluginapi.HostAuthModelState, len(auth.ModelStates))
+	for model, state := range auth.ModelStates {
+		if state == nil {
+			continue
+		}
+		entry.ModelStates[model] = pluginapi.HostAuthModelState{
+			Status:         string(state.Status),
+			StatusMessage:  logging.SafeDiagnosticForLog(state.StatusMessage),
+			Unavailable:    state.Unavailable,
+			NextRetryAfter: runtimeRetryAfter(state.NextRetryAfter, state.Quota.NextRecoverAt, now),
+		}
+	}
+	entry.StatusMessage = logging.SafeDiagnosticForLog(auth.StatusMessage)
+	entry.CredentialBlocked = coreauth.HasUnauthorizedAuthFailure(auth) || coreauth.HasDisabledInvalidGrantFailure(auth)
+	if auth.Disabled || auth.Status == coreauth.StatusDisabled || entry.CredentialBlocked {
+		return
+	}
+	if auth.Quota.Exceeded && auth.Quota.Reason == "credential_quota" {
+		entry.CredentialCooldown = !runtimeRetryAfter(auth.NextRetryAfter, auth.Quota.NextRecoverAt, now).IsZero()
+		return
+	}
+	// A direct auth-level failure has no per-model state. Once model states
+	// exist, Unavailable/NextRetryAfter are aggregates and must not be promoted
+	// to a credential-wide penalty.
+	if len(auth.ModelStates) == 0 && auth.LastError != nil && auth.Status == coreauth.StatusError && auth.Unavailable {
+		entry.CredentialCooldown = !runtimeRetryAfter(auth.NextRetryAfter, auth.Quota.NextRecoverAt, now).IsZero()
+	}
+}
